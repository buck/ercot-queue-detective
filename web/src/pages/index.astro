<script>
  // maplibregl is loaded as a global from the CDN <script> tag above

  // ---- Tab switching ----
  const tabs = document.querySelectorAll('nav.tabs button');
  const panels = document.querySelectorAll('.tab-panel');
  function activateTab(tabId) {
    tabs.forEach(b => b.classList.toggle('active', b.dataset.tab === tabId));
    panels.forEach(p => p.classList.toggle('active', p.id === tabId));
    if (tabId === 'movers-tab') renderMovers();
    if (tabId === 'map-tab' && typeof map !== 'undefined' && map) {
      // Container size may have changed while hidden; force a recompute.
      setTimeout(() => map.resize(), 50);
    }
  }
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      tabs.forEach(b => b.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(btn.dataset.tab).classList.add('active');
      if (btn.dataset.tab === 'movers-tab') renderMovers();
      if (btn.dataset.tab === 'map-tab' && typeof map !== 'undefined' && map) {
        setTimeout(() => map.resize(), 50);
      }
    });
  });

  // Story callout CTA jumps to Movers tab
  document.querySelectorAll('[data-jump]').forEach(el => {
    el.addEventListener('click', () => activateTab(el.dataset.jump));
  });

  // ---- Fuel color map ----
  const FUEL_COLORS = {
    SOL: '#f59e0b',
    WIN: '#38bdf8',
    GAS: '#f97316',
    OTH: '#a78bfa',
    NUC: '#f87171',
    WAT: '#34d399',
    OIL: '#fb923c',
    COA: '#6b7280',
  };
  function fuelColor(fuel) { return FUEL_COLORS[fuel] || '#94a3b8'; }

  function fuelPillClass(fuel) {
    const map = { SOL: 'pill-fuel-SOL', WIN: 'pill-fuel-WIN', GAS: 'pill-fuel-GAS', OTH: 'pill-fuel-OTH', NUC: 'pill-fuel-NUC' };
    return map[fuel] || 'pill-fuel-default';
  }

  // Heuristic: is the interconnecting entity a developer that reads as AI /
  // data-center-flavored? Curated list of specific operators plus any entity
  // whose name contains "Data Center". This is *soft* evidence — a developer
  // name is not a customer disclosure — but the pattern is strong enough to
  // be worth surfacing on the map.
  const AI_DC_ENTITIES = new Set([
    'CleanAI, LLC',
    'Kalnin Ventures, LLC',
    'Palomino Alpha, LLC',
    'Bullock Data Center, LLC',
    'Liberty Data Center I, LLC',
  ]);
  function isAIDCFlavored(entity) {
    if (!entity) return false;
    if (AI_DC_ENTITIES.has(entity)) return true;
    return /\bdata\s*center\b/i.test(entity);
  }

  // ---- Load data ----
  let allProjects = [];
  let moversData = null;
  let changedINRs = new Set();

  async function loadData() {
    const [projRes, moversRes] = await Promise.all([
      fetch('/api/projects.json'),
      fetch('/api/movers.json'),
    ]);
    const projData = await projRes.json();
    moversData = await moversRes.json();
    allProjects = projData.projects || [];
    changedINRs = new Set((moversData.movers || []).map(m => m.inr));
    initMap();
    updateResultCount(allProjects.length);
  }

  // ---- Map ----
  let map;
  let selectedINR = null;

  function initMap() {
    const isTouch = matchMedia('(pointer: coarse)').matches;
    map = new maplibregl.Map({
      container: 'map',
      style: {
        version: 8,
        sources: {
          'osm': {
            type: 'raster',
            tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
            tileSize: 256,
            attribution: '© <a href="https://openstreetmap.org">OpenStreetMap</a>',
          }
        },
        layers: [{ id: 'osm', type: 'raster', source: 'osm', paint: { 'raster-opacity': 0.25 } }]
      },
      center: [-99.5, 31.5],
      zoom: 5.2,
      minZoom: 4,
      maxZoom: 14,
      // On touch devices, a finger tap wobbles ~5-10px; default 3px counts it
      // as a drag and discards the click. Bump so taps register on dots.
      clickTolerance: isTouch ? 10 : 3,
    });

    // Double-tap-to-zoom competes with tap-on-dot on touch. Disable it —
    // users can pinch-to-zoom instead.
    if (isTouch) {
      map.doubleClickZoom.disable();
    }

    map.addControl(new maplibregl.NavigationControl(), 'top-right');
    map.on('load', () => {
      addProjectsLayer(allProjects);
      // Belt-and-suspenders: force a resize sequence after load so the
      // canvas matches the container even if layout finalized late.
      map.resize();
      setTimeout(() => map.resize(), 100);
      setTimeout(() => map.resize(), 500);
      applyURLParams();
    });

    // Recompute size on window resize, orientation change, and any
    // container-size change (e.g. mobile URL bar hide/show).
    window.addEventListener('resize', () => map.resize());
    window.addEventListener('orientationchange', () => setTimeout(() => map.resize(), 300));
    if (typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(() => map.resize());
      ro.observe(document.getElementById('map').parentElement);
    }
  }

  function buildGeoJSON(projects) {
    return {
      type: 'FeatureCollection',
      features: projects
        .filter(p => p.lat && p.lon)
        .map(p => ({
          type: 'Feature',
          geometry: { type: 'Point', coordinates: [p.lon, p.lat] },
          properties: {
            inr: p.inr,
            name: p.project_name || p.inr,
            fuel: p.fuel || 'OTH',
            mw: p.capacity_mw || 0,
            county: p.county || '',
            zone: p.cdr_zone || '',
            cod: p.projected_cod || '',
            entity: p.interconnecting_entity || '',
            phase: p.gim_study_phase || '',
            changed: changedINRs.has(p.inr) ? 1 : 0,
            ai_dc: isAIDCFlavored(p.interconnecting_entity) ? 1 : 0,
            color: fuelColor(p.fuel),
          }
        }))
    };
  }

  function addProjectsLayer(projects) {
    const geojson = buildGeoJSON(projects);

    if (map.getSource('projects')) {
      map.getSource('projects').setData(geojson);
      return;
    }

    map.addSource('projects', { type: 'geojson', data: geojson, cluster: true, clusterMaxZoom: 7, clusterRadius: 40 });

    // Clusters
    map.addLayer({
      id: 'clusters',
      type: 'circle',
      source: 'projects',
      filter: ['has', 'point_count'],
      paint: {
        'circle-color': '#38bdf8',
        'circle-radius': ['step', ['get', 'point_count'], 16, 10, 22, 50, 28],
        'circle-opacity': 0.7,
      }
    });
    map.addLayer({
      id: 'cluster-count',
      type: 'symbol',
      source: 'projects',
      filter: ['has', 'point_count'],
      layout: { 'text-field': '{point_count_abbreviated}', 'text-size': 11, 'text-font': ['Open Sans Regular'] },
      paint: { 'text-color': '#0a0f1e' }
    });

    // Individual points — size by MW, color by fuel
    map.addLayer({
      id: 'projects-points',
      type: 'circle',
      source: 'projects',
      filter: ['!', ['has', 'point_count']],
      paint: {
        // Larger dots on touch devices so taps hit their intended target.
        'circle-radius': matchMedia('(pointer: coarse)').matches
          ? ['interpolate', ['linear'], ['get', 'mw'], 0, 6, 100, 9, 500, 13, 1000, 18, 2000, 24]
          : ['interpolate', ['linear'], ['get', 'mw'], 0, 4, 100, 6, 500, 9, 1000, 13, 2000, 18],
        'circle-color': ['get', 'color'],
        'circle-opacity': ['case',
          ['==', ['get', 'ai_dc'], 1], 1.0,
          ['==', ['get', 'changed'], 1], 1.0,
          0.6],
        'circle-stroke-width': ['case',
          ['==', ['get', 'ai_dc'], 1], 3,
          ['==', ['get', 'changed'], 1], 2,
          0],
        'circle-stroke-color': ['case',
          ['==', ['get', 'ai_dc'], 1], '#fbbf24',
          '#ffffff'],
      }
    });

    // Click handlers — use a bounding-box query around the tap point so a
    // slightly-off finger tap still finds the nearest dot.
    const TAP_PAD = matchMedia('(pointer: coarse)').matches ? 12 : 4;
    function bboxAround(p) {
      return [[p.x - TAP_PAD, p.y - TAP_PAD], [p.x + TAP_PAD, p.y + TAP_PAD]];
    }

    map.on('click', (e) => {
      // Prefer a point tap; if none, try a cluster tap.
      const pointHits = map.queryRenderedFeatures(bboxAround(e.point), { layers: ['projects-points'] });
      if (pointHits.length) {
        showProjectCard(pointHits[0].properties);
        return;
      }
      const clusterHits = map.queryRenderedFeatures(bboxAround(e.point), { layers: ['clusters'] });
      if (clusterHits.length) {
        const clusterId = clusterHits[0].properties.cluster_id;
        map.getSource('projects').getClusterExpansionZoom(clusterId).then(zoom => {
          map.easeTo({ center: clusterHits[0].geometry.coordinates, zoom });
        });
      }
    });

    map.on('mouseenter', 'projects-points', () => { map.getCanvas().style.cursor = 'pointer'; });
    map.on('mouseleave', 'projects-points', () => { map.getCanvas().style.cursor = ''; });
    map.on('mouseenter', 'clusters', () => { map.getCanvas().style.cursor = 'pointer'; });
    map.on('mouseleave', 'clusters', () => { map.getCanvas().style.cursor = ''; });
  }

  function showProjectCard(props) {
    selectedINR = props.inr;
    document.getElementById('card-name').textContent = props.name;
    document.getElementById('card-meta').innerHTML = `<b>${(props.mw || 0).toFixed(1)} MW</b> · ${props.fuel || ''}`;
    document.getElementById('card-county').textContent = props.county || '—';
    document.getElementById('card-zone').textContent = props.zone || '—';
    document.getElementById('card-cod').textContent = props.cod ? props.cod.slice(0, 10) : '—';
    document.getElementById('card-entity').textContent = props.entity || '—';

    const pills = document.getElementById('card-pills');
    pills.innerHTML = '';
    const fuelPill = document.createElement('span');
    fuelPill.className = `pill ${fuelPillClass(props.fuel)}`;
    fuelPill.textContent = props.fuel || 'N/A';
    pills.appendChild(fuelPill);
    if (props.phase) {
      const phasePill = document.createElement('span');
      phasePill.className = 'pill pill-phase';
      phasePill.textContent = props.phase;
      pills.appendChild(phasePill);
    }
    if (props.changed) {
      const changePill = document.createElement('span');
      changePill.className = 'pill pill-change';
      changePill.textContent = 'Changed this month';
      pills.appendChild(changePill);
    }
    if (props.ai_dc) {
      const aiPill = document.createElement('span');
      aiPill.className = 'ai-dc-tag';
      aiPill.textContent = '◆ AI/DC-flavored';
      aiPill.title = 'Developer name matches an AI / data-center-flavored operator';
      pills.appendChild(aiPill);
    }

    document.getElementById('card-detail-btn').onclick = () => {
      window.location.href = `/project/${props.inr}`;
    };

    document.getElementById('project-card').style.display = 'block';
  }

  // Close button: stop event bubbling so MapLibre's underlying canvas
  // doesn't also receive the tap (which had been re-opening the card).
  function closeCard(e) {
    if (e) { e.stopPropagation(); e.preventDefault(); }
    document.getElementById('project-card').style.display = 'none';
  }
  const cardCloseBtn = document.getElementById('card-close');
  cardCloseBtn.addEventListener('click', closeCard);
  cardCloseBtn.addEventListener('touchend', closeCard);

  // ---- Filters ----
  function getFilteredProjects() {
    const fuel = document.getElementById('filter-fuel').value;
    const zone = document.getElementById('filter-zone').value;
    const minMW = parseInt(document.getElementById('filter-mw').value) || 0;
    const phase = document.getElementById('filter-phase').value;
    const changedOnly = document.getElementById('changed-only').checked;
    const aiDCOnly = document.getElementById('ai-dc-only').checked;

    return allProjects.filter(p => {
      if (fuel && p.fuel !== fuel) return false;
      if (zone && p.cdr_zone !== zone) return false;
      if (minMW > 0 && (p.capacity_mw || 0) < minMW) return false;
      if (phase && !(p.gim_study_phase || '').includes(phase)) return false;
      if (changedOnly && !changedINRs.has(p.inr)) return false;
      if (aiDCOnly && !isAIDCFlavored(p.interconnecting_entity)) return false;
      return true;
    });
  }

  function updateResultCount(n) {
    document.getElementById('result-count').textContent = `${n.toLocaleString()} projects shown`;
  }

  function applyFilters() {
    const filtered = getFilteredProjects();
    updateResultCount(filtered.length);
    if (map && map.getSource('projects')) {
      addProjectsLayer(filtered);
    }
  }

  document.getElementById('filter-fuel').addEventListener('change', applyFilters);
  document.getElementById('filter-zone').addEventListener('change', applyFilters);
  document.getElementById('filter-phase').addEventListener('change', applyFilters);
  document.getElementById('changed-only').addEventListener('change', applyFilters);
  document.getElementById('ai-dc-only').addEventListener('change', applyFilters);
  document.getElementById('filter-mw').addEventListener('input', (e) => {
    const v = parseInt(e.target.value);
    document.getElementById('mw-label').textContent = v === 0 ? '0+ MW' : `${v}+ MW`;
    applyFilters();
  });
  document.getElementById('reset-filters').addEventListener('click', () => {
    document.getElementById('filter-fuel').value = '';
    document.getElementById('filter-zone').value = '';
    document.getElementById('filter-mw').value = '0';
    document.getElementById('mw-label').textContent = '0+ MW';
    document.getElementById('filter-phase').value = '';
    document.getElementById('changed-only').checked = false;
    document.getElementById('ai-dc-only').checked = false;
    applyFilters();
  });

  // ---- Deep-linking: ?focus=<INR> and ?filter=ai-dc ----
  function focusOn(inr) {
    const p = allProjects.find(x => x.inr === inr);
    if (!p || !p.lat || !p.lon) return;
    activateTab('map-tab');
    if (typeof closeSidebar === 'function') closeSidebar();
    map.flyTo({ center: [p.lon, p.lat], zoom: 11, duration: 800 });
    showProjectCard({
      inr: p.inr,
      name: p.project_name || p.inr,
      fuel: p.fuel || 'OTH',
      mw: p.capacity_mw || 0,
      county: p.county || '',
      zone: p.cdr_zone || '',
      cod: p.projected_cod || '',
      entity: p.interconnecting_entity || '',
      phase: p.gim_study_phase || '',
      changed: changedINRs.has(p.inr) ? 1 : 0,
      ai_dc: isAIDCFlavored(p.interconnecting_entity) ? 1 : 0,
    });
  }

  function activateAIDCFilter() {
    activateTab('map-tab');
    if (typeof closeSidebar === 'function') closeSidebar();
    document.getElementById('ai-dc-only').checked = true;
    applyFilters();
    closeCard();
    if (map) map.easeTo({ center: [-99.5, 31.5], zoom: 5.2, duration: 800 });
  }

  function applyURLParams() {
    const p = new URLSearchParams(location.search);
    if (p.get('filter') === 'ai-dc') {
      document.getElementById('ai-dc-only').checked = true;
      applyFilters();
    }
    const focus = p.get('focus');
    if (focus) setTimeout(() => focusOn(focus), 150);
  }

  // Demo Shortcuts + primary story CTA
  document.querySelectorAll('[data-focus]').forEach(btn => {
    btn.addEventListener('click', () => focusOn(btn.dataset.focus));
  });
  document.querySelectorAll('[data-shortcut="filter-ai-dc"]').forEach(btn => {
    btn.addEventListener('click', activateAIDCFilter);
  });

  // ---- Movers ----
  let moversFilter = '';

  function renderMovers() {
    if (!moversData) return;
    const { from_snapshot, to_snapshot, movers } = moversData;

    const fromLabel = from_snapshot ? new Date(from_snapshot + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : '';
    const toLabel = to_snapshot ? new Date(to_snapshot + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : '';
    document.getElementById('movers-subtitle').textContent = `Changes from ${fromLabel} → ${toLabel}`;

    const filtered = moversFilter ? movers.filter(m => m.change_type === moversFilter) : movers;

    const grid = document.getElementById('movers-grid');
    if (filtered.length === 0) {
      grid.innerHTML = '<p style="color:var(--muted)">No movers match this filter.</p>';
      return;
    }
    grid.innerHTML = filtered.map(m => {
      const isAI = isAIDCFlavored(m.interconnecting_entity);
      const entityLine = m.interconnecting_entity
        ? `<div class="mover-entity"><span class="lbl">by</span> ${escHtml(m.interconnecting_entity)}${isAI ? ' <span class="ai-dc-tag" title="AI / data-center-flavored developer">◆ AI/DC</span>' : ''}</div>`
        : '';
      return `
      <div class="mover-card">
        <div class="mover-header">
          <div class="mover-name">${escHtml(m.project_name || m.inr)}</div>
          <div class="mover-mw">${m.capacity_mw ? m.capacity_mw.toFixed(0) + ' MW' : '—'}</div>
        </div>
        <div class="mover-meta">${escHtml(m.county || '')} · ${escHtml(m.fuel_label || m.fuel || '')}</div>
        <span class="change-badge badge-${m.change_type}">${changeLabel(m.change_type)}</span>
        <div class="mover-detail">${escHtml(m.detail || '')}</div>
        ${entityLine}
        <a class="mover-link" href="/project/${m.inr}">View timeline →</a>
      </div>
    `;
    }).join('');
  }

  function changeLabel(ct) {
    const labels = {
      NEW: 'New', WITHDRAWN: 'Withdrawn', STATUS_ADVANCED: 'Advanced',
      STATUS_REVERTED: 'Reverted', COD_SLIPPED: 'COD Slipped',
      COD_ADVANCED: 'COD Advanced', CAPACITY_CHANGED: 'MW Changed', OWNERSHIP_CHANGED: 'New Owner',
    };
    return labels[ct] || ct;
  }

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  document.getElementById('movers-type-filters').addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    document.querySelectorAll('#movers-type-filters button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    moversFilter = btn.dataset.ct;
    renderMovers();
  });

  // ---- Ask (LLM) ----
  const askForm = document.getElementById('ask-form');
  const askInput = document.getElementById('ask-input');
  const askSubmit = document.getElementById('ask-submit');
  const askAnswer = document.getElementById('ask-answer');

  function mdRender(md) {
    // Tiny markdown renderer: paragraphs, bold, italics, links, lists, inline code.
    const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    let html = esc(md);
    // Fenced code -> inline (we don't expect much)
    html = html.replace(/```([\s\S]*?)```/g, (_, c) => `<pre>${c.trim()}</pre>`);
    // Inline code
    html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
    // Bold
    html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    // Links [text](url)
    html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
    // Lists: lines starting with "- " or "* "
    const lines = html.split('\n');
    let out = [];
    let inList = false;
    for (const line of lines) {
      const m = line.match(/^\s*[-*]\s+(.*)$/);
      if (m) {
        if (!inList) { out.push('<ul>'); inList = true; }
        out.push(`<li>${m[1]}</li>`);
      } else {
        if (inList) { out.push('</ul>'); inList = false; }
        if (line.trim()) out.push(`<p>${line}</p>`);
      }
    }
    if (inList) out.push('</ul>');
    return out.join('');
  }

  async function askQuestion(q) {
    askAnswer.innerHTML = '<div class="loading">Thinking…</div>';
    askSubmit.disabled = true;
    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ question: q }),
      });
      const data = await res.json();
      if (!res.ok || data.error) {
        askAnswer.innerHTML = `<div class="error">${data.error || 'Request failed.'}</div>`;
      } else {
        askAnswer.innerHTML = mdRender(data.answer || '(no answer)');
      }
    } catch (e) {
      askAnswer.innerHTML = `<div class="error">Network error: ${e.message}</div>`;
    } finally {
      askSubmit.disabled = false;
    }
  }

  askForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = askInput.value.trim();
    if (q) askQuestion(q);
  });

  document.querySelectorAll('.example-q').forEach(btn => {
    btn.addEventListener('click', () => {
      askInput.value = btn.dataset.q;
      askQuestion(btn.dataset.q);
    });
  });

  // ---- Mobile filters drawer ----
  const sidebarEl = document.querySelector('.sidebar');
  const backdropEl = document.getElementById('sidebar-backdrop');
  const openBtn = document.getElementById('filter-toggle');
  const closeBtn = document.getElementById('sidebar-close');

  function openSidebar() {
    sidebarEl.classList.add('open');
    backdropEl.classList.add('visible');
  }
  function closeSidebar() {
    sidebarEl.classList.remove('open');
    backdropEl.classList.remove('visible');
  }
  openBtn?.addEventListener('click', openSidebar);
  closeBtn?.addEventListener('click', closeSidebar);
  backdropEl?.addEventListener('click', closeSidebar);
  // Close drawer when a tab is switched (so overlay never leaks across tabs).
  document.querySelectorAll('nav.tabs button').forEach(b => b.addEventListener('click', closeSidebar));

  // ---- Boot ----
  loadData();
</script>
</body>
</html>
