---
import projects from '../../../public/api/projects.json';
import diffsData from '../../../public/api/diffs_by_inr.json';

export function getStaticPaths() {
  return (projects.projects || []).map(p => ({
    params: { inr: p.inr },
    props: { project: p, diffs: (diffsData as Record<string, unknown[]>)[p.inr] || [] },
  }));
}

const { project, diffs } = Astro.props;
const { inr } = Astro.params;

const CHANGE_LABELS: Record<string, string> = {
  NEW: 'New entry',
  WITHDRAWN: 'Withdrawn',
  STATUS_ADVANCED: 'Phase advanced',
  STATUS_REVERTED: 'Phase reverted',
  COD_SLIPPED: 'COD slipped',
  COD_ADVANCED: 'COD moved earlier',
  CAPACITY_CHANGED: 'Capacity changed',
  OWNERSHIP_CHANGED: 'Owner changed',
};

const FUEL_LABELS: Record<string, string> = {
  SOL: 'Solar', WIN: 'Wind', GAS: 'Gas', OTH: 'BESS / Other',
  NUC: 'Nuclear', WAT: 'Hydro', OIL: 'Oil/Other', COA: 'Coal',
};
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{project?.project_name || inr} — ERCOT Queue Detective</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0a0f1e; --surface: #111827; --border: #1e293b;
      --text: #e2e8f0; --muted: #64748b; --accent: #38bdf8;
    }
    body { background: var(--bg); color: var(--text); font-family: system-ui, -apple-system, sans-serif; min-height: 100vh; }
    .back { display: inline-flex; align-items: center; gap: 0.4rem; padding: 1rem 1.5rem; font-size: 0.82rem; color: var(--muted); text-decoration: none; }
    .back:hover { color: var(--accent); }
    .page { max-width: 820px; margin: 0 auto; padding: 0 1.5rem 3rem; }
    .badge { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; background: #1e293b; color: var(--accent); padding: 0.2rem 0.6rem; border-radius: 999px; }
    h1 { font-size: 1.75rem; font-weight: 800; line-height: 1.2; margin: 0.75rem 0 0.4rem; }
    .subtitle { font-size: 0.9rem; color: var(--muted); margin-bottom: 1.5rem; }

    .meta-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.75rem; margin-bottom: 2rem; }
    .meta-card { background: var(--surface); border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.875rem; }
    .meta-card .l { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.25rem; }
    .meta-card .v { font-size: 1rem; font-weight: 600; }
    .meta-card .v.big { font-size: 1.4rem; color: var(--accent); }

    h2 { font-size: 1rem; font-weight: 700; margin: 1.75rem 0 0.75rem; }

    /* Timeline */
    .timeline { position: relative; padding-left: 1.5rem; }
    .timeline::before { content: ''; position: absolute; left: 0.35rem; top: 0; bottom: 0; width: 2px; background: var(--border); }
    .tl-event { position: relative; margin-bottom: 1rem; }
    .tl-event::before { content: ''; position: absolute; left: -1.15rem; top: 0.3rem; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); }
    .tl-event .date { font-size: 0.72rem; color: var(--muted); margin-bottom: 0.15rem; }
    .tl-event .label { font-size: 0.82rem; font-weight: 600; }
    .tl-event .detail { font-size: 0.78rem; color: var(--muted); margin-top: 0.1rem; font-style: italic; }
    .tl-event.type-NEW::before { background: #34d399; }
    .tl-event.type-COD_SLIPPED::before { background: #fbbf24; }
    .tl-event.type-STATUS_ADVANCED::before { background: #38bdf8; }
    .tl-event.type-WITHDRAWN::before { background: #f87171; }
    .tl-event.type-CAPACITY_CHANGED::before { background: #a78bfa; }

    /* Milestone table */
    .milestone-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
    .milestone-table th { text-align: left; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding: 0.4rem 0.75rem; border-bottom: 1px solid var(--border); }
    .milestone-table td { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); }
    .milestone-table tr:last-child td { border-bottom: none; }
    .milestone-table .done { color: #34d399; }
    .milestone-table .pending { color: var(--muted); }

    .inr-tag { font-size: 0.72rem; font-family: monospace; color: var(--muted); margin-top: 0.5rem; }

    .poi-block { background: var(--surface); border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.875rem 1rem; margin: 0 0 2rem; }
    .poi-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.4rem; }
    .poi-value { font-size: 0.85rem; color: var(--text); white-space: pre-wrap; word-break: break-word; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; line-height: 1.5; }
    .source-attr { font-size: 0.75rem; color: var(--muted); margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  </style>
</head>
<body>
  <a class="back" href="/">← Back to map</a>
  <div class="page">
    {project ? (
      <>
        <div class="badge">{FUEL_LABELS[project.fuel as string] || project.fuel || 'Unknown'}</div>
        <h1>{project.project_name}</h1>
        <div class="subtitle">
          {project.interconnecting_entity} · {project.county} County · {project.cdr_zone} zone
        </div>
        <div class="inr-tag">INR: {inr} · {project.source_type} GEN</div>

        <div class="meta-grid">
          <div class="meta-card">
            <div class="l">Capacity</div>
            <div class="v big">{project.capacity_mw != null ? project.capacity_mw.toFixed(1) : '—'} MW</div>
          </div>
          <div class="meta-card">
            <div class="l">Projected COD</div>
            <div class="v">{project.projected_cod ? project.projected_cod.slice(0, 10) : '—'}</div>
          </div>
          <div class="meta-card">
            <div class="l">GIM Phase</div>
            <div class="v" style="font-size:0.82rem">{project.gim_study_phase || '—'}</div>
          </div>
          <div class="meta-card">
            <div class="l">IA Signed</div>
            <div class="v">{project.ia_signed ? project.ia_signed.slice(0, 10) : 'No'}</div>
          </div>
        </div>

        {project.poi_location && (
          <div class="poi-block">
            <div class="poi-label">Point of Interconnection</div>
            <div class="poi-value">{project.poi_location}</div>
          </div>
        )}

        <!-- Change history -->
        <div id="timeline-container">
          <h2>Change history</h2>
          <p style="color:var(--muted); font-size:0.82rem">Loading timeline…</p>
        </div>

        <!-- Milestone dates -->
        <h2>Milestone dates (current)</h2>
        <table class="milestone-table">
          <thead>
            <tr><th>Milestone</th><th>Date</th></tr>
          </thead>
          <tbody>
            {[
              ['Screening Study Started', project.ss_started ?? null],
              ['Screening Study Complete', project.ss_complete ?? null],
              ['FIS Requested', project.fis_requested ?? null],
              ['FIS Approved', project.fis_approved ?? null],
              ['IA Signed', project.ia_signed ?? null],
              ['Construction Start', project.construction_start ?? null],
              ['Construction End', project.construction_end ?? null],
              ['Approved for Synchronization', project.approved_synchronization ?? null],
            ].filter(([, val]) => val !== null).map(([label, val]) => (
              <tr>
                <td>{label}</td>
                <td class={val ? 'done' : 'pending'}>{val ? String(val).slice(0, 10) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="source-attr">
          Source: ERCOT Generator Interconnection Status Report ·
          <a href="https://www.ercot.com/gridinfo/resource" target="_blank" style="color:var(--accent)">ercot.com/gridinfo/resource</a>
        </div>
      </>
    ) : (
      <p>Project {inr} not found.</p>
    )}
  </div>

  <script define:vars={{ diffs, CHANGE_LABELS }}>
    const container = document.getElementById('timeline-container');
    if (!diffs || diffs.length === 0) {
      container.querySelector('p').textContent = 'No changes recorded for this project.';
    } else {
      container.innerHTML = '<h2>Change history</h2><div class="timeline" id="tl"></div>';
      const tl = document.getElementById('tl');
      diffs.forEach(d => {
        const div = document.createElement('div');
        div.className = `tl-event type-${d.change_type}`;
        div.innerHTML = `
          <div class="date">${d.to_snapshot}</div>
          <div class="label">${CHANGE_LABELS[d.change_type] || d.change_type}</div>
          <div class="detail">${d.detail || ''}</div>
        `;
        tl.appendChild(div);
      });
    }
  </script>
</body>
</html>
